/* rofi for sugoi: drun (Mod-p, the root's right click), the window lists and the
 * confirmations of doc/config.rb. Install: copy this directory to ~/.config/rofi. */
configuration {
    modi: "drun,run,window";
    /* rofi 2 reads no X resources: set your Xft.dpi here (xrdb -query). */
    dpi: 192;
    show-icons: true;
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    display-drun: "<span font='Symbols Nerd Font Mono'></span>";
    display-run: "<span font='Symbols Nerd Font Mono'></span>";
    display-window: "<span font='Symbols Nerd Font Mono'></span>";
}

@theme "sugoi.rasi"
