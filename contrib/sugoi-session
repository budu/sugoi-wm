#!/bin/sh
# An X session for sugoi: the wallpaper, a polkit agent, the notification daemon and
# the bar, then sugoi. GDM starts it through contrib/sugoi.desktop, from
# outside the user's home, which GDM's own user cannot read (TryExec would fail and
# hide the entry); scripts/install puts it in /usr/local/bin.
# startx through ~/.xinitrc: exec <this checkout>/contrib/sugoi-session
# If sugoi cannot start (a Ruby upgrade, see contrib/sugoi-ruby.hook), another WM takes
# over, so the session still opens.

# GDM's session may not have cargo's binaries on PATH: sugoi, and sugoictl for the
# config's confirmations.
export PATH="$HOME/.cargo/bin:$PATH"
# The wallpaper feh last set (`feh --bg-scale <image>` writes ~/.fehbg); sugoi keeps
# it, and paints the root black without one.
[ -x "$HOME/.fehbg" ] && "$HOME/.fehbg"
dunst &
command -v lxpolkit >/dev/null && lxpolkit &
(sleep 1 && polybar sugoi) &
sugoi && exit
for wm in awesome i3 xterm; do
    command -v "$wm" >/dev/null && exec "$wm"
done
