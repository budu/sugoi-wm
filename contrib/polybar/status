#!/bin/sh
# A polybar module for the awesome widgets' status scripts, whose first line is
# "<text> <severity>" and the rest a popup ("@@POPUP@@" then Pango markup).
#   status <icon> <command...>          the label, colored by severity
#   status --popup <command...>         the popup, through notify-send (dunst)
set -u
if [ "${1:-}" = --popup ]; then
    shift
    body=$("$@" 2>&1 | tail -n +2 | sed '1{/^@@POPUP@@$/d}')
    exec notify-send --app-name=sugoi "$(basename "$1")" "$body"
fi
icon=$1
shift
if ! first=$("$@" 2>/dev/null | head -n 1) || [ -z "$first" ]; then
    printf '%%{F#f7768e}%s !%%{F-}\n' "$icon"
    exit 0
fi
severity=${first##* }
text=${first% *}
case $severity in
    warning) color='#e0af68' ;;
    critical | error) color='#f7768e' ;;
    *) color='' ;;
esac
if [ -n "$color" ]; then
    printf '%s %%{F%s}%s%%{F-}\n' "$icon" "$color" "$text"
else
    printf '%s %s\n' "$icon" "$text"
fi
