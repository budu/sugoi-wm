#!/bin/bash
# A polybar module for the awesome widgets' status scripts, whose first line is
# "<text> <severity>" and the rest a popup ("@@POPUP@@" then Pango markup).
#   status <icon> [--unit <text>] <command...>
#                                       the label, colored by severity, with the unit
#                                       after the text (`--unit %` for a percentage)
#   status --popup <command...> [--then <command...>]...
#                                       the popup, through sugoi-popup ([O4]); each
#                                       --then command's whole output follows
set -u
if [[ ${1:-} == --popup ]]; then
    shift
    # One command's part of the popup, or its error; $1 says whether to drop the label.
    section() {
        local drop=$1 err out
        shift
        err=$(mktemp)
        if out=$("$@" 2>"$err"); then
            if [[ $drop == yes ]]; then
                printf '%s\n' "$out" | tail -n +2 | sed '1{/^@@POPUP@@$/d}'
            else
                printf '%s\n' "$out"
            fi
        else
            printf '<span foreground="#f7768e"><b>%s failed</b>\n' "$(basename "$1")"
            sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' "$err"
            printf '</span>\n'
        fi
        rm -f "$err"
    }
    drop=yes
    command=()
    for arg in "$@" --then; do
        if [[ $arg != --then ]]; then
            command+=("$arg")
            continue
        fi
        if ((${#command[@]})); then
            [[ $drop == no ]] && echo
            section "$drop" "${command[@]}"
            drop=no
        fi
        command=()
    done | sugoi-popup
    exit
fi
icon=$1
shift
unit=''
if [[ ${1:-} == --unit ]]; then
    unit=$2
    shift 2
fi
if ! first=$("$@" 2>/dev/null | head -n 1) || [ -z "$first" ]; then
    printf '%%{F#f7768e}%s !%%{F-}\n' "$icon"
    exit 0
fi
severity=${first##* }
text=${first% *}
case $severity in
    warning) color='#e0af68' ;;
    critical | error) color='#f7768e' ;;
    *) color='' ;;
esac
if [ -n "$color" ]; then
    printf '%s %%{F%s}%s%s%%{F-}\n' "$icon" "$color" "$text" "$unit"
else
    printf '%s %s%s\n' "$icon" "$text" "$unit"
fi
